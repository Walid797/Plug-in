{
  "name": "hoshmand-photo-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Hoshmand Photo Studio — offline-first Persian (Dari) ID/passport photo editor and print studio",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "start": "node server/serve.mjs",
    "build:static": "node tools/publish-static.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e/run-all.mjs",
    "test:onnx-fixture": "python3 tools/make-test-onnx.py tests/fixtures/test-only-matting-signature.onnx",
    "check": "npm run build && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "esbuild": "0.28.2",
    "lucide-static": "1.70.0",
    "onnxruntime-web": "1.31.1",
    "playwright": "^1.65.0",
    "preact": "11.2.0",
    "vazirmatn": "33.0.3"
  }
}
